{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.ts": {
      "includeFiles": "_static/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ping",
      "destination": "/api/index.ts"
    },
    {
      "source": "/w/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/webhook(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|health|ping|w|webhook).*\\.[a-zA-Z0-9]+)",
      "destination": "/$1"
    },
    {
      "source": "/((?!api|health|ping|w|webhook).*)$",
      "destination": "/index.html"
    }
  ]
}
