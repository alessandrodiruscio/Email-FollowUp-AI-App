{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ping:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/reasons:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|health|ping|reasons).*)",
      "destination": "/api/index.ts"
    }
  ]
}
